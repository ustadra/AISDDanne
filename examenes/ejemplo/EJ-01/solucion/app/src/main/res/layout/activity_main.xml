<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Imagen centrada en la pantalla -->
    <ImageView
        android:id="@+id/ivMascota"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="#274c77"
        android:contentDescription="Mascota"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Botón de la izquierda -->
    <ImageButton
        android:id="@+id/btnAnterior"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:background="#274c77"
        android:contentDescription="Anterior"
        app:layout_constraintBottom_toBottomOf="@+id/ivMascota"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivMascota"
        app:srcCompat="@android:drawable/ic_media_previous" />

    <!-- Botón de la derecha -->
    <ImageButton
        android:id="@+id/btnSiguiente"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginEnd="16dp"
        android:background="#274c77"
        android:contentDescription="Siguiente"
        app:layout_constraintBottom_toBottomOf="@+id/ivMascota"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivMascota"
        app:srcCompat="@android:drawable/ic_media_next" />

    <!-- Nombre debajo de la imagen -->
    <TextView
        android:id="@+id/tvNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivMascota" />
</androidx.constraintlayout.widget.ConstraintLayout>
