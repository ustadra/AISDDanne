{
  "examen": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ../.claude/hooks/adaptador.cjs antigravity SessionStart version-check",
        "timeout": 20
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|send_command_input|read_file|view_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ../.claude/hooks/adaptador.cjs antigravity PreToolUse secret-scan no-ai-attribution block-protected-merges vendor-gate",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ../.claude/hooks/adaptador.cjs antigravity Stop unit-close",
        "timeout": 40
      }
    ]
  }
}
